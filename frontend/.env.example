VITE_SUPABASE_URL=https://YOUR_SUPABASE_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ─── Workshop Session Control ────────────────────────────────────────────
# SESSION 1 (Database session) → Set to false  (no SMTP, skip OTP)
# SESSION 2 (SMTP/Auth session) → Set to true   (enable OTP verification)
VITE_OTP_ENABLED=false
